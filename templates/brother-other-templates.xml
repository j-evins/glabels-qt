      <Markup-margin x_size="1.5mm" y_size="2.0mm" />
      <Layout nx="1" ny="1" x0="0" y0="0" dx="0" dy="0"/>
    </Label-continuous>
  </Template>

  <Template brand="Brother" part="P-700 24mm" _description="Continuous label 24 mm"
            size="roll" roll_width="29mm" width="23.98mm" >
    <Meta category="label"/>
    <Meta category="mail"/> 
    <Label-continuous id="0" width="23.98mm" min_height="5mm" max_height="1000mm" default_height="50mm" >
      <Markup-margin x_size="1.5mm" y_size="2.0mm" />
